# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Auth & Database (Optionnel si vous connectez votre projet Supabase)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY=""

# Twilio SMS OTP Gateway (Optionnel pour l'envoi de vrais SMS en production)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+1234567890"

# Resend Transactional Email (Optionnel pour les emails de commande et sécurité)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="notifications@afrique-business.app"

# Facebook Graph API v26.0 (Import automatique des publications de votre Page Facebook)
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_TOKEN=""
FACEBOOK_PAGE_NAME="Afrique Business"

